# Healysis Backend Environment Configuration Example
# Copy this file to .env and configure real operational variables locally or in deployment.
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS TO SOURCE CONTROL.

# Application Settings
PROJECT_NAME="Healysis Core Telemetry Network"
VERSION="2.0.0"
API_V1_STR="/api/v1"
ENABLE_DOCS=false
TESTING=false

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://healysis_user:YOUR_DB_PASSWORD@localhost:5432/healysis_db"

# Security & CORS Settings
SECRET_KEY="YOUR_SUPER_SECRET_HMAC_KEY_MIN_32_BYTES"
ALLOWED_ORIGINS="http://localhost:3000,https://healysis.ashlynxcyber.in"

# Firebase Authentication & Admin Credentials
FIREBASE_PROJECT_ID="healysis-sentry-network"
FIREBASE_CREDENTIALS_FILE="/path/to/firebase-service-account.json"
# FIREBASE_CREDENTIALS_JSON='{"type": "service_account", ...}'

# Google GenAI / Gemini AI Advisor Configuration
GEMINI_API_KEY="YOUR_GOOGLE_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"
