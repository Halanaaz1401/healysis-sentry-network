# Healysis Backend Production Environment Configuration Template
# Set all required credentials in your production runtime environment (never commit real secrets).

APP_ENV=production
PROJECT_NAME="Healysis Core Telemetry Network"
ENABLE_DOCS=false
ALLOW_DEMO_TOKENS=false
AUTO_SEED=false

# Security Key (Generate min 32 random characters: openssl rand -hex 32)
SECRET_KEY=your_production_secret_key_min_32_bytes_placeholder

# Production PostgreSQL Database Connection URL
DATABASE_URL=postgresql://healysis_user:healysis_pass@localhost:5432/healysis_db

# CORS Allowed Origins (comma-separated or JSON list of production frontend URLs)
ALLOWED_ORIGINS=https://healysis.ashlynxcyber.in,http://localhost:3000

# Google GenAI / Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=healysis-sentry-network
FIREBASE_CREDENTIALS_FILE=
FIREBASE_CREDENTIALS_JSON=
